# Copiar a .env y completar. Toda variable que pueda alterar un resultado
# experimental entra en la huella que se registra con cada medición: cambiarla
# invalida la comparabilidad con lo ya recolectado.

# --- Persistencia -----------------------------------------------------------
URL_BASE_DATOS=sqlite:///./plataforma.db

# --- Seguridad --------------------------------------------------------------
# Cadena larga y aleatoria. Deriva además los seudónimos de participante, así
# que cambiarla después de empezar a recolectar rompe la trazabilidad.
CLAVE_SECRETA=cambiala-por-una-cadena-larga-y-aleatoria

# --- Modelos ----------------------------------------------------------------
# Sin esta clave el sistema corre en modo simulado: sirve para desarrollar y
# probar el circuito, pero los episodios quedan marcados y no son dato válido.
ANTHROPIC_API_KEY=

MODELO_PARTICIPANTE=claude-opus-5
# El solver de referencia define la escala de todos los indicadores de diseño.
MODELO_SOLVER=claude-opus-5
# Jueces de familias distintas entre sí y distintas del participante.
MODELOS_JUEZ=claude-opus-5,claude-sonnet-5

ESFUERZO_PARTICIPANTE=medium
ESFUERZO_SOLVER=high
ESFUERZO_JUEZ=medium

# --- Protocolo --------------------------------------------------------------
# 30 certifica v <= 0.095 ante cero aciertos; 60 certifica v <= 0.049.
ENSAYOS_POR_CELDA=30
MAX_TURNOS_EPISODIO=24
SEMILLA_ALEATORIZACION=20260818

# --- Interfaz ---------------------------------------------------------------
ORIGENES_CORS=http://localhost:5173,http://127.0.0.1:5173
